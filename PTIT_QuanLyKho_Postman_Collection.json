{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d",
    "name": "PTIT_OOP_Quan_Ly_Kho_APIs",
    "description": "Bộ sưu tập Postman kiểm thử các REST API cho hệ thống Quản lý kho (PTIT OOP):\n- Ghi chú sản phẩm\n- Tra cứu lô hàng\n- Báo cáo & thống kê",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ghi chú sản phẩm",
      "item": [
        {
          "name": "Lấy danh sách tất cả sản phẩm",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Xem chi tiết sản phẩm theo ID (kèm ghi chú)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/products/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "Cập nhật ghi chú sản phẩm",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ghiChu\": \"Hàng dễ vỡ, yêu cầu bảo quản nơi khô mát, nhiệt độ phòng không quá 30 độ C.\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/products/1/ghi-chu",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "1", "ghi-chu"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Tra cứu lô hàng",
      "item": [
        {
          "name": "Lấy tất cả lô hàng",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/lo-hang",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "lo-hang"]
            }
          }
        },
        {
          "name": "Tra cứu lô hàng theo mã lô (Query param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/lo-hang/tra-cuu?ma=LH-VNM",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "lo-hang", "tra-cuu"],
              "query": [
                {
                  "key": "ma",
                  "value": "LH-VNM"
                }
              ]
            }
          }
        },
        {
          "name": "Tra cứu nâng cao (từ khóa + trạng thái HSD)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/lo-hang/tra-cuu-nang-cao?keyword=Vinamilk&trangThai=con_han",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "lo-hang", "tra-cuu-nang-cao"],
              "query": [
                {
                  "key": "keyword",
                  "value": "Vinamilk"
                },
                {
                  "key": "trangThai",
                  "value": "con_han"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Báo cáo & Thống kê",
      "item": [
        {
          "name": "Báo cáo tổng quan thống kê kho",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/products/thong-ke",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "thong-ke"]
            }
          }
        }
      ]
    }
  ]
}
